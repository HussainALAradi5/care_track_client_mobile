# Copy to .env (git-ignored) and run: flutter run --dart-define-from-file=.env
# Only public values belong here; the app bundle is not a secret store.
API_URL=http://localhost:8080
AUTH_ISSUER=http://localhost:8081/realms/caretrack
AUTH_CLIENT_ID=caretrack-mobile
# true only for local http development; release builds must use https
AUTH_ALLOW_HTTP=true
